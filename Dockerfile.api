FROM node:24-alpine AS verify
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY server ./server
RUN npm run test:server

FROM node:24-alpine
ENV NODE_ENV=production PORT=3000
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server ./server
USER node
EXPOSE 3000
CMD ["node", "server/index.mjs"]
